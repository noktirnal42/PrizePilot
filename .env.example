# Local API
PRIZEPILOT_API_HOST=127.0.0.1
PRIZEPILOT_API_PORT=8080

# Gemini API. Leave empty for deterministic local fallback mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Google Cloud / Firestore. Leave USE_FIRESTORE=false for local demo.
GOOGLE_CLOUD_PROJECT=
FIRESTORE_COLLECTION=opportunities
USE_FIRESTORE=false

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8080

